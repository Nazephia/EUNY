[configuration]

entry_symbol = "euny_library_init"
compatibility_minimum = "4.5"

[libraries]

linux.debug.x86_64 = "res://bin/libeuny.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libeuny.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/euny.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/euny.windows.template_release.x86_64.dll"
